+def _csv_truth(value: object) -> bool:
+    """Interpret values read through ``csv.DictReader`` without string truthiness."""
+    if isinstance(value, bool):
+        return value
+    if value is None:
+        return False
+    if isinstance(value, (int, float)):
+        try:
+            return math.isfinite(float(value)) and float(value) != 0.0
+        except (TypeError, ValueError):
+            return False
+    return str(value).strip().lower() in {"true", "1", "yes", "y", "on"}
+
+
+def _finite_csv_float(value: object) -> float | None:
+    """Return one finite CSV numeric value; blanks, NaN, and invalid text are absent."""
+    if value is None or (isinstance(value, str) and not value.strip()):
+        return None
+    try:
+        number = float(value)
+    except (TypeError, ValueError):
+        return None
+    return number if math.isfinite(number) else None
+
+
+def _finite_csv_column(rows: list[dict[str, object]], key: str) -> list[float]:
+    values: list[float] = []
+    for row in rows:
+        value = _finite_csv_float(row.get(key))
+        if value is not None:
+            values.append(value)
+    return values
+
+
+def _cached_endpoint_completion_statistics(
+    measurements: list[dict[str, object]],
+    relaxations: list[dict[str, object]],
+) -> dict[str, object]:
+    """Summarize completed cached-endpoint artifacts after CSV round-tripping."""
+    changed = [row for row in relaxations if _csv_truth(row.get("changed"))]
+    activations = [
+        row for row in measurements if _csv_truth(row.get("cache_activated"))
+    ]
+    requested_gains = _finite_csv_column(relaxations, "controller_gain_requested")
+    applied_gains = _finite_csv_column(relaxations, "controller_gain_applied")
+    applied_changes = _finite_csv_column(
+        changed, "applied_relative_frobenius_change"
+    )
+    return {
+        "endpoint_activation_count": len(activations),
+        "fast_layer_decision_count": len(relaxations),
+        "fast_changed_layer_count": len(changed),
+        "above_target_measurement_count": sum(
+            row.get("alpha_side") == "above_target" for row in measurements
+        ),
+        "below_target_measurement_count": sum(
+            row.get("alpha_side") == "below_target" for row in measurements
+        ),
+        "above_target_activation_count": sum(
+            row.get("alpha_side") == "above_target"
+            and _csv_truth(row.get("cache_activated"))
+            for row in measurements
+        ),
+        "below_target_activation_count": sum(
+            row.get("alpha_side") == "below_target"
+            and _csv_truth(row.get("cache_activated"))
+            for row in measurements
+        ),
+        "mean_controller_gain_requested": (
+            sum(requested_gains) / len(requested_gains) if requested_gains else 0.0
+        ),
+        "max_controller_gain_requested": max(requested_gains, default=0.0),
+        "mean_controller_gain_applied": (
+            sum(applied_gains) / len(applied_gains) if applied_gains else 0.0
+        ),
+        "max_controller_gain_applied": max(applied_gains, default=0.0),
+        "mean_applied_relative_frobenius_change": (
+            sum(applied_changes) / len(applied_changes) if applied_changes else 0.0
+        ),
+        "max_applied_relative_frobenius_change": max(
+            applied_changes, default=0.0
+        ),
+    }
+
+
