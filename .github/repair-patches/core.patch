+    def _terminal_fast_row(
+        self,
+        name,
+        ep,
+        step,
+        reason,
+        *,
+        before=math.nan,
+        converged=False,
+        measurement_interval: int | None = None,
+    ):
+        """Return a terminal relaxation row with the full stable CSV schema.
+
+        Terminal rows do not request or apply a movement, so movement-only
+        numeric fields are NaN.  Keeping every field in the same order as an
+        ordinary fast-relaxation row prevents append-only schema collisions and
+        avoids blank-string surprises when the completed artifact is re-read.
+        """
+        cfg = self.cfg.adaptive
+        cadence = measurement_interval or resolve_endpoint_measurement_interval(
+            cfg, self.interval
+        )
+        eps = 1e-12
+        initial = float(ep.initial_endpoint_relative_distance)
+        progress = (
+            1.0 - float(before) / max(initial, eps)
+            if math.isfinite(float(before))
+            else math.nan
+        )
+        cumulative = float(ep.cumulative_applied_relative_change)
+        remaining = max(
+            0.0,
+            float(cfg.max_cumulative_relative_frobenius_change_per_refresh)
+            - cumulative,
+        )
+        return {
+            "optimizer_step": step,
+            "layer_name": name,
+            "block": block_index(name),
+            "matrix_type": matrix_type(name),
+            "endpoint_measurement_step": ep.measurement_step,
+            "endpoint_age_steps": step - ep.measurement_step,
+            "cached_raw_alpha": ep.raw_alpha,
+            "cached_smoothed_alpha": ep.smoothed_alpha,
+            "cached_alpha_distance": ep.alpha_distance,
+            "cached_alpha_hardness": ep.alpha_hardness,
+            "global_event_hardness": ep.global_event_hardness,
+            "max_per_step_gain": cfg.max_per_step_gain,
+            "controller_gain_requested": math.nan,
+            "controller_gain_applied": math.nan,
+            "initial_endpoint_relative_distance": initial,
+            "endpoint_relative_distance_before": before,
+            "endpoint_relative_distance_after": before,
+            "endpoint_progress_ratio_before": progress,
+            "endpoint_progress_ratio": progress,
+            "requested_relative_frobenius_change": math.nan,
+            "applied_relative_frobenius_change": math.nan,
+            "trust_region_limit": cfg.max_relative_frobenius_change_per_step,
+            "measurement_interval": cadence,
+            "apply_interval": cfg.apply_interval,
+            "eligible_fast_steps_in_refresh": eligible_fast_steps(
+                cadence,
+                cfg.apply_interval,
+                cfg.skip_fast_apply_on_measurement_step,
+            ),
+            "max_endpoint_fraction_per_refresh": cfg.max_endpoint_fraction_per_refresh,
+            "derived_interval_gain": derived_interval_gain(cfg, cadence),
+            "configured_max_per_step_gain": cfg.max_per_step_gain,
+            "effective_base_gain": effective_base_gain(cfg, cadence),
+            "max_cumulative_relative_frobenius_change_per_refresh": cfg.max_cumulative_relative_frobenius_change_per_refresh,
+            "cumulative_applied_relative_change_before": cumulative,
+            "cumulative_applied_relative_change_after": cumulative,
